# Base path (ex.: / se estiver na raiz do domínio)
VITE_BASE_PATH=/

# API REST (dev: server.mjs na porta 3001)
# Em produção, aponte para a URL pública da API se houver
VITE_API_URL=

# Supabase (opcional — o app funciona sem, com API em memória)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Porta da API local
PORT=3001
